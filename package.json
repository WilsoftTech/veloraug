{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:fixtures": "node --env-file-if-exists=.env.local tests/browser/fixtures/generate.mjs",
    "test:catalogue": "npx supabase@2.117.0 db reset --local --sql-paths ./seeds/dev-catalogue.sql && vitest run --config vitest.integration.config.mts",
    "gateway:dev": "node --env-file-if-exists=.env.local scripts/media-gateway-dev.mjs",
    "ingest": "node --env-file-if-exists=.env.local --import ./scripts/ingest/register.mjs scripts/ingest/cli.mts",
    "discovery:replay": "node --import ./scripts/ingest/register.mjs scripts/discovery/replay.mts",
    "test:db": "npx supabase@2.117.0 db reset --local --no-seed && npx supabase@2.117.0 test db --local",
    "test:db:isolated": "node scripts/isolated-db.mjs test",
    "test:integration:isolated": "vitest run --config vitest.discovery.config.mts -t \"^(?!.*saves catalogue movies and series by internal id)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
