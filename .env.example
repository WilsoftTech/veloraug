# Velora UG environment. Copy to `.env.local` for local development.
# Placeholders only: never commit `.env.local` or real credentials.
# NEXT_PUBLIC_* values are sent to the browser. Never give a private key,
# token or connection string that prefix.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public origin for canonical URLs and Open Graph metadata. Set the real
# production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase: catalogue, database and auth
# -----------------------------------------------------------------------------
# Browser-safe project URL and publishable key (Dashboard > Project Settings >
# API Keys). Row Level Security, not this key, protects data. With both unset
# the app runs guest-only; production builds on Vercel fail without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# TMDB: metadata enrichment (server-side only)
# -----------------------------------------------------------------------------
# v4 "API Read Access Token" (preferred) or v3 API key. With neither set, the
# app serves a small built-in sample catalogue.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# -----------------------------------------------------------------------------
# Migration tooling only (never read by the app, never set in Vercel)
# -----------------------------------------------------------------------------
# Session-pooler connection string (port 5432) for `supabase db push --db-url`
# on IPv4-only networks. See docs/PHASE_B_CATALOGUE_DESIGN.md.
DATABASE_URL=
