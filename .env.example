# Velora UG environment. Copy to `.env.local` for local development.
# Placeholders only: never commit `.env.local` or real credentials.
# NEXT_PUBLIC_* values are sent to the browser. Never give a private key,
# token or connection string that prefix.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public origin for canonical URLs and Open Graph metadata. Set the real
# production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase: catalogue, database and auth
# -----------------------------------------------------------------------------
# Browser-safe project URL and publishable key (Dashboard > Project Settings >
# API Keys). Row Level Security, not this key, protects data. With both unset
# the app runs guest-only; production builds on Vercel fail without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# TMDB: metadata enrichment (server-side only)
# -----------------------------------------------------------------------------
# v4 "API Read Access Token" (preferred) or v3 API key. With neither set, the
# app serves a small built-in sample catalogue.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# -----------------------------------------------------------------------------
# Ingestion uploader CLI only (`npm run ingest`; operator machine, never Vercel)
# -----------------------------------------------------------------------------
# Self-hosted Telegram Bot API server origin (telegram-bot-api --local). There
# is no default and api.telegram.org is refused: large uploads must never go
# to the cloud endpoint. http:// is accepted only on loopback.
TELEGRAM_BOT_API_URL=
# One bot per channel. Movies go only to the Movies channel, episodes only to
# the Series channel. Channel ids are numeric (-100...), not @usernames.
TELEGRAM_MOVIES_BOT_TOKEN=
TELEGRAM_MOVIES_CHANNEL_ID=
TELEGRAM_SERIES_BOT_TOKEN=
TELEGRAM_SERIES_CHANNEL_ID=
# Bots already logged out of the cloud and moved to the local server: "movie",
# "series" or both, comma-separated. Unlisted bots are refused before any
# request, because a first request would log them in on the local server.
# Each listed bot needs its numeric id (must match its token) and its exact
# Telegram username without @; the adapter checks both with getMe.
TELEGRAM_BOT_API_LOCAL_BOTS=
TELEGRAM_MOVIES_BOT_ID=
TELEGRAM_MOVIES_BOT_USERNAME=
TELEGRAM_SERIES_BOT_ID=
TELEGRAM_SERIES_BOT_USERNAME=
# Private chat where both bots may post; crash reconciliation forwards channel
# messages here to read their caption token, then deletes the copies.
TELEGRAM_RECONCILE_CHAT_ID=
# Optional: "<local library prefix>=><same folder as the Bot API server sees
# it>", e.g. D:\Media=>/mnt/d/Media when the server runs under WSL or Docker.
TELEGRAM_BOT_API_PATH_MAP=
# Worker store: service-role (secret) key for the four ingest_upload_* RPCs,
# which only service_role may execute. Uploader machine only; never in Vercel,
# never NEXT_PUBLIC_. The project URL is NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_SERVICE_ROLE_KEY=
# Kill switch for real Telegram media uploads (upload/resume --execute). Only
# the exact value "true" enables them; unset or anything else denies. Keep it
# false here and in .env.local: enable it only in the environment of the one
# controlled command, then remove it (docs/PHASE_C_INGESTION_DESIGN.md,
# "C2B.2C.4"). Never NEXT_PUBLIC_, never committed as true.
REAL_TELEGRAM_UPLOADS_AUTHORIZED=false
# Optional: journal directory (default ~/.velora-ingest/journal). It must be
# outside the repository, or under the Git-ignored .velora-ingest/ folder.
VELORA_INGEST_JOURNAL_DIR=
# The Bot API server's own TELEGRAM_API_ID / TELEGRAM_API_HASH (my.telegram.org)
# belong to that server's configuration, not this file.

# -----------------------------------------------------------------------------
# Migration tooling only (never read by the app, never set in Vercel)
# -----------------------------------------------------------------------------
# Session-pooler connection string (port 5432) for `supabase db push --db-url`
# on IPv4-only networks. See docs/PHASE_B_CATALOGUE_DESIGN.md.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Media gateway (services/media-gateway). Only MEDIA_GATEWAY_TOKEN_SECRET is also
# read by the Next.js server (see "Media playback" below); everything else here
# is gateway-only and never set in Vercel. Never NEXT_PUBLIC_. See
# docs/PHASE_C_INGESTION_DESIGN.md, "E1.2", "E1.2A" and "E2".
# -----------------------------------------------------------------------------
# Restricted database identity. The user MUST be velora_media_gateway (via the
# pooler: velora_media_gateway.<project-ref>), which may only execute
# media_gateway.resolve_movie_version. Owner, service_role and any other
# credential is refused at startup; there is no fallback.
MEDIA_GATEWAY_DATABASE_URL=
# HMAC key for media authorization tokens: base64url, at least 32 random bytes.
# Shared: the gateway verifies with it and the Next.js server signs with it, so
# both must hold the same value. Server-only; set it in Vercel as a secret.
MEDIA_GATEWAY_TOKEN_SECRET=
# Owner-only file holding the media reader's exported MTProto session.
MEDIA_GATEWAY_SESSION_FILE=
# Optional: listen address and port (defaults 127.0.0.1 and 8787), and browser
# origins allowed to read ranges by script (comma-separated; media elements need none).
MEDIA_GATEWAY_HOST=
MEDIA_GATEWAY_PORT=
MEDIA_GATEWAY_ALLOWED_ORIGINS=
# Dedicated media-reader bot (never on any Bot API server): id and exact username
# for the identity assertion. The token is needed only for a first login, which
# happens only when MEDIA_GATEWAY_ALLOW_BOT_LOGIN is exactly "true".
TELEGRAM_MEDIA_BOT_ID=
TELEGRAM_MEDIA_BOT_USERNAME=
TELEGRAM_MEDIA_BOT_TOKEN=
MEDIA_GATEWAY_ALLOW_BOT_LOGIN=false
# Optional dedicated app credentials (my.telegram.org); default TELEGRAM_API_ID/HASH.
TELEGRAM_MEDIA_API_ID=
TELEGRAM_MEDIA_API_HASH=
# Resource limits (MEDIA_GATEWAY_MAX_ACTIVE_STREAMS, ..._MAX_READS_IN_FLIGHT,
# ..._MAX_RESPONSE_BYTES, ...) are optional and bounded; see lib/media-gateway/limits.ts.

# -----------------------------------------------------------------------------
# Media playback (Next.js server, E2): stream capabilities for signed-in users
# -----------------------------------------------------------------------------
# MEDIA_GATEWAY_TOKEN_SECRET above signs them. This is the gateway's public
# origin, the only host capabilities are issued for: a bare origin, HTTPS in
# production; http:// only for a loopback gateway in development and tests.
# Unset or invalid, the stream-token endpoint answers 503. Never NEXT_PUBLIC_.=
