# Velora UG environment. Copy to `.env.local` for local development.
# Placeholders only: never commit `.env.local` or real credentials.
# NEXT_PUBLIC_* values are sent to the browser. Never give a private key,
# token or connection string that prefix.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public origin for canonical URLs and Open Graph metadata. Set the real
# production domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase: catalogue, database and auth
# -----------------------------------------------------------------------------
# Browser-safe project URL and publishable key (Dashboard > Project Settings >
# API Keys). Row Level Security, not this key, protects data. With both unset
# the app runs guest-only; production builds on Vercel fail without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# TMDB: metadata enrichment (server-side only)
# -----------------------------------------------------------------------------
# v4 "API Read Access Token" (preferred) or v3 API key. With neither set, the
# app serves a small built-in sample catalogue.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# -----------------------------------------------------------------------------
# Ingestion uploader CLI only (`npm run ingest`; operator machine, never Vercel)
# -----------------------------------------------------------------------------
# Self-hosted Telegram Bot API server origin (telegram-bot-api --local). There
# is no default and api.telegram.org is refused: large uploads must never go
# to the cloud endpoint. http:// is accepted only on loopback.
TELEGRAM_BOT_API_URL=
# One bot per channel. Movies go only to the Movies channel, episodes only to
# the Series channel. Channel ids are numeric (-100...), not @usernames.
TELEGRAM_MOVIES_BOT_TOKEN=
TELEGRAM_MOVIES_CHANNEL_ID=
TELEGRAM_SERIES_BOT_TOKEN=
TELEGRAM_SERIES_CHANNEL_ID=
# Private chat where both bots may post; crash reconciliation forwards channel
# messages here to read their caption token, then deletes the copies.
TELEGRAM_RECONCILE_CHAT_ID=
# Optional: "<local library prefix>=><same folder as the Bot API server sees
# it>", e.g. D:\Media=>/mnt/d/Media when the server runs under WSL or Docker.
TELEGRAM_BOT_API_PATH_MAP=
# Worker store: service-role (secret) key for the four ingest_upload_* RPCs,
# which only service_role may execute. Uploader machine only; never in Vercel,
# never NEXT_PUBLIC_. The project URL is NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: journal directory (default ~/.velora-ingest/journal). It must be
# outside the repository, or under the Git-ignored .velora-ingest/ folder.
VELORA_INGEST_JOURNAL_DIR=
# The Bot API server's own TELEGRAM_API_ID / TELEGRAM_API_HASH (my.telegram.org)
# belong to that server's configuration, not this file.

# -----------------------------------------------------------------------------
# Migration tooling only (never read by the app, never set in Vercel)
# -----------------------------------------------------------------------------
# Session-pooler connection string (port 5432) for `supabase db push --db-url`
# on IPv4-only networks. See docs/PHASE_B_CATALOGUE_DESIGN.md.
DATABASE_URL=
