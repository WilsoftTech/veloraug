# Template only. Installation/enabling requires Gate B; secrets are outside Git.
[Unit]
Description=Velora Movies discovery (no automatic publication)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=velora-discovery
Group=velora-discovery
WorkingDirectory=/opt/velora
EnvironmentFile=/etc/velora/discovery.env
ExecStart=/usr/bin/node --experimental-transform-types --import /opt/velora/scripts/ingest/register.mjs /opt/velora/services/media-gateway/discovery.mts
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/velora-discovery
MemoryMax=512M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
